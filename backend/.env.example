# Server
PORT=8000
ENVIRONMENT=dev
LOG_LEVEL=DEBUG

# CORS (comma-separated for multiple origins, or * for all)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Game Settings
MAX_PLAYERS_PER_GAME=6
GAME_TIMEOUT_MINUTES=60

# WebSocket Settings
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10

# Rate Limiting (SH-002)
RATE_LIMIT_ENABLED=true
WS_MAX_MESSAGES_PER_SECOND=10

# Room Cleanup (SH-005)
ROOM_TIMEOUT_MINUTES=30
ROOM_CLEANUP_INTERVAL_SECONDS=60
