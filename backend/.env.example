# Server
PORT=8000
# dev | prod  (prod turns off FastAPI debug mode)
ENVIRONMENT=dev
LOG_LEVEL=DEBUG

# CORS (comma-separated for multiple origins, or * for all).
# Not needed when the backend serves the built frontend (same origin).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Built React app to serve (relative paths resolve against backend/).
# Served only if the directory contains index.html. Default shown.
# FRONTEND_DIST=../frontend/dist

# Game Settings
# Product name (site title, headers, bench pages) and theme/numbers (backend/rulesets/).
# GAME_BRAND_NAME=Buyout
# GAME_RULESET=default
MAX_PLAYERS_PER_GAME=6
GAME_TIMEOUT_MINUTES=60

# WebSocket Settings
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10

# LLM players (all optional; see backend/agents/llm/config.py). Placeholders only:
# never commit real keys.
# Key for the built-in Anthropic entries.
ANTHROPIC_API_KEY=
# Any OpenAI-compatible endpoint (setting base URL + model enables the entry).
GAME_LLM_OPENAI_BASE_URL=
GAME_LLM_OPENAI_MODEL=
GAME_LLM_OPENAI_API_KEY=
# JSON list that REPLACES the default catalog entries.
GAME_LLM_CATALOG=
# Directory for JSONL decision logs with full prompts (leave empty to disable).
GAME_LLM_LOG_DIR=
